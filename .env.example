# Copy to .env (git-ignored) and fill in. Never commit the real .env.
#   cp .env.example .env
#
# Get these from Groww: Profile -> Settings -> Trading APIs (Groww Cloud API Keys page).
# Option A (recommended for a bot): TOTP flow. Does not need daily approval.
GROWW_API_KEY=
GROWW_TOTP_SECRET=
# Option B: API key + secret flow. Needs approval on Groww every day.
GROWW_API_SECRET=
# Option C: paste an access token you generated yourself (expires daily).
GROWW_ACCESS_TOKEN=

# Live trading switch. Leave blank to stay in paper mode no matter what config.toml says.
# To allow real orders, set it to exactly:  YES_I_ACCEPT_REAL_MONEY_RISK
GROWW_ENABLE_LIVE=

# Optional: Telegram notifications for price alerts (growwbot alerts watch).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
